      "@type": "ScholarlyArticle",
      "@id": "https://works.battleoftheforms.com/papers/thinking-unthinkable-ai-justice/#article",
      "headline": "Thinking the Unthinkable: AI in the Service of Justice",
      "name": "Thinking the Unthinkable: AI in the Service of Justice",
      "author": [
        {
          "@type": "Person",
          "name": "Yonathan A. Arbel"
        }
      ],
      "datePublished": "2024",
      "description": "Argues that large language models can provide context-sensitive evidence of ordinary meaning as a supplement to dictionaries, precedent, interpretive canons, and judicial intuition. Using Judge Kevin Newsom's concurrence in the Eleventh Circuit's Snell trampoline-insurance dispute, the essay explains generative interpretation and proposes safeguards for responsible use.",
      "keywords": [
        "generative interpretation",
        "large language models",
        "ordinary meaning",
        "legal interpretation",
        "judicial decision-making",
        "prompt documentation",
        "human oversight",
        "access to justice"
      ],
