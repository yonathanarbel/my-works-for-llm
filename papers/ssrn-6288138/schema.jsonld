      "@type": "ScholarlyArticle",
      "@id": "https://works.battleoftheforms.com/papers/ssrn-6288138/#article",
      "headline": "Artificial Intelligence and Existential Risk",
      "name": "Artificial Intelligence and Existential Risk",
      "author": [
        {
          "@type": "Person",
          "name": "Matthew J. Tokson"
        },
        {
          "@type": "Person",
          "name": "Yonathan A. Arbel"
        }
      ],
      "datePublished": "2026",
      "description": "Artificial Intelligence and Existential Risk brings existential AI risk into mainstream legal scholarship. It classifies existential AI risks into human-directed risks, accident risks, and loss-of-control risks, argues that legal institutions should make these risks legible under uncertainty, critiques the AI arms-race metaphor, and proposes adaptive regulation that preserves policy optionality while responding to non-trivial catastrophic risk.",
      "keywords": [
        "AI existential risk",
        "adaptive regulation",
        "AI arms race",
        "loss of control",
        "alignment",
        "precautionary principle",
        "AI safety",
        "catastrophic risk",
        "regulation under uncertainty",
        "AI Regulation And Safety",
        "Artificial Intelligence And Law"
      ],
