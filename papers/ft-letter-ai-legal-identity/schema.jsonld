      "@id": "https://works.battleoftheforms.com/papers/ft-letter-ai-legal-identity/#article",
      "headline": "Letter: What Happens Once You Give AI Agents Legal Identity",
      "name": "Letter: What Happens Once You Give AI Agents Legal Identity",
      "author": [
        {
          "@type": "Person",
          "name": "Yonathan A. Arbel"
        },
        {
          "@type": "Person",
          "name": "Simon Goldstein"
