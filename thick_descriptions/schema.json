{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://works.battleoftheforms.com/thick-descriptions/schema.json",
  "title": "Evidence-linked proposition description",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposition_id",
    "paper_id",
    "paper_title",
    "authors",
    "citation",
    "source_type",
    "source_url",
    "printed_pages",
    "pdf_pages",
    "section",
    "claim",
    "thick_description",
    "significance",
    "connections",
    "limitations",
    "evidence_summary",
    "review_status",
    "human_reviewed",
    "generated_on"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "proposition_id": {"type": "string", "minLength": 1},
    "paper_id": {"type": "string", "minLength": 1},
    "paper_title": {"type": "string", "minLength": 1},
    "authors": {"type": "string", "minLength": 1},
    "citation": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "printed_pages": {"type": "string", "pattern": "^([0-9]+(-[0-9]+)?|unpaginated)$"},
    "pdf_pages": {"type": "string", "pattern": "^([0-9]+(-[0-9]+)?|unpaginated)$"},
    "section": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "thick_description": {"type": "string", "minLength": 1},
    "significance": {"type": "string", "minLength": 1},
    "connections": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "limitations": {"type": "string", "minLength": 1},
    "evidence_summary": {"type": "string", "minLength": 1},
    "review_status": {
      "enum": ["machine-drafted-source-checked", "human-reviewed"]
    },
    "human_reviewed": {"type": "boolean"},
    "generated_on": {"type": "string", "format": "date"}
  }
}
